# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel AI Gateway (server-side, set in Vercel env)
# Model MUST be a gateway "provider/model" slug. OpenAI models (and some premium
# models) require paid/BYOK credits; claude-haiku-4.5 works on the free tier.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Admin emails (comma-separated, server-side only)
ADMIN_EMAILS=

# Public GitHub repo URL (optional)
VITE_GITHUB_REPO_URL=https://github.com/tmcfarlane/zeroclickboards

# Hosted ChatGPT/Codex connection (server-only; never prefix these with VITE_)
# Enable only after private migrations and the dedicated SQL role are provisioned.
ZEROBOARD_CONNECTOR_ENABLED=false
ZEROBOARD_CONNECTOR_ISSUER=https://board.zeroclickdev.ai
ZEROBOARD_CONNECTOR_DATABASE_URL=
# 32 random bytes encoded as canonical base64; keep separate from the proposal key.
ZEROBOARD_CONNECTOR_VAULT_KEY=
ZEROBOARD_CONNECTOR_PROPOSAL_KEY=
# Exact public client IDs and callbacks from the client's connection setup.
# [{"client_id":"…","client_name":"ChatGPT","redirect_uris":["https://…"],"token_endpoint_auth_method":"none"}]
ZEROBOARD_CONNECTOR_CLIENTS=[]
ZEROBOARD_CONNECTOR_ALLOWED_ORIGINS=[]
